{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "QEMU kernel debug",
            "type": "cppdbg",
            "request": "launch",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb-multiarch",
            "program": "${workspaceFolder}/iotest.elf",
            "cwd": "${workspaceFolder}",
            "miDebuggerServerAddress": "localhost:1234",
            "useExtendedRemote": false,
            "stopAtEntry": false,
            "externalConsole": false,
        }
    ]
}